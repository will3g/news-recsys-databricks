# Copie para app/.streamlit/secrets.toml (gitignored) ou cole em
# Streamlit Community Cloud > App settings > Secrets.
[databricks]
server_hostname = "dbc-xxxxxxxx-xxxx.cloud.databricks.com"
http_path = "/sql/1.0/warehouses/xxxxxxxxxxxxxxxx"
access_token = "dapi..."
catalog = "workspace"
schema = "news_recsys_dev"   # app QA: news_recsys_qa · app PROD: news_recsys_prod
